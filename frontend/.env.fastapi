# 接続先：FastAPI（ポート 8000）  … npm run dev:fastapi で使われます
VITE_API_BASE_URL=http://127.0.0.1:8000

# 画面（Vite）のポート
DEV_PORT=5173

# 公開サイトの URL（例: https://www.katachi-web.jp）。LINE や SNS で URL を送ったときのプレビュー画像（public/ogp.png）に使います。
# 空のままでもサイトは動きます（プレビュー画像が出ないだけです）。
SITE_URL=

# Google アナリティクス（GA4）の測定ID（G- で始まる）。本番用にビルドしたときだけ計測します。空のままなら計測しません。
VITE_GA_ID=
