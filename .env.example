# Katachi サイトの設定ファイル（FastAPI のバックエンドが読みます）
# 起動コマンドの初回実行時に、このファイルをもとに .env が自動作成されます。

# 管理画面のログイン情報。起動のたびにこの内容で管理者アカウントを作成・更新します。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__GENERATE__

# SQLite データベースの保存先（プロジェクトフォルダからの相対パス、または絶対パス）
DATABASE_PATH=data/app.db

# API サーバーの待ち受け先（FastAPI: 8000）。起動コマンドの前に HOST=0.0.0.0 などを付けても変更できます。
HOST=127.0.0.1
BACKEND_PORT=8000

# HTTPS で公開する場合は true にしてください（ログイン Cookie に Secure 属性が付きます）
COOKIE_SECURE=false

# 画面（Vite）の URL。ここに書いた URL からの API 呼び出しだけを許可します（CORS）。
# 画面のポートは frontend/.env.fastapi（5173）で設定しています。
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Outlook（Microsoft Graph）でメールを送る設定（元の Laravel 版と同じ Azure のアプリ）
# 初回だけ、管理画面の「メール」→「Outlook にサインイン」でサインインしてください。
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=consumers
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
